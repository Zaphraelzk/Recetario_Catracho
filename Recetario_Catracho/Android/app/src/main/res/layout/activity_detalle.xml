<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETALLE DE LA RECETA"
            android:textColor="#8B4513"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Imagen -->
        <ImageView
            android:id="@+id/imgDetalle"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            android:contentDescription="Imagen de la receta" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/txtNombreDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la receta"
            android:textColor="#4E260D"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp" />

        <!-- Categoría -->
        <TextView
            android:id="@+id/txtCategoriaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <!-- Dificultad -->
        <TextView
            android:id="@+id/txtDificultadDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <!-- Tiempo -->
        <TextView
            android:id="@+id/txtTiempoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <!-- Porciones -->
        <TextView
            android:id="@+id/txtPorcionesDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <!-- Ingredientes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INGREDIENTES"
            android:textColor="#8B4513"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/txtIngredientesDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="10dp" />

        <!-- Preparación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PREPARACIÓN"
            android:textColor="#8B4513"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/txtPasosDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="10dp" />

        <!-- Botones editar y eliminar -->
        <LinearLayout
            android:id="@+id/layoutAccionesReceta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnEditarReceta"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="EDITAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#8B4513" />

            <Button
                android:id="@+id/btnEliminarReceta"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="ELIMINAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#B3261E" />

        </LinearLayout>

        <!-- Botón volver -->
        <Button
            android:id="@+id/btnVolverDetalle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VOLVER"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8B4513"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
