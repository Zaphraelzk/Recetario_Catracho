<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFF8F0">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recetario Catracho"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#70439A"
        android:layout_marginBottom="12dp"/>

    <!-- Búsqueda por nombre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtBuscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Buscar receta..."
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"/>

    </LinearLayout>

    <!-- Filtro por categoría -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filtrar por categoría:"
        android:textStyle="bold"
        android:textColor="#70439A"
        android:layout_marginTop="12dp"/>

    <Spinner
        android:id="@+id/spinnerCategorias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <!-- Indicador de carga -->
    <ProgressBar
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- Mensaje de estado -->
    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando recetas..."
        android:gravity="center"
        android:padding="12dp"
        android:visibility="gone"/>

    <!-- Botón reintentar -->
    <Button
        android:id="@+id/btnReintentar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REINTENTAR"
        android:visibility="gone"/>

    <!-- Lista de recetas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRecetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Agregar receta -->
    <Button
        android:id="@+id/btnAgregar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AGREGAR RECETA"
        android:backgroundTint="#70439A"
        android:textColor="#FFFFFF"/>

</LinearLayout>
