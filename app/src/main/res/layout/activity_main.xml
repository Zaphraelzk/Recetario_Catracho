<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFF8F0">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RECETARIO CATRACHO"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#7B3F00"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txtDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descubre y comparte las mejores recetas hondureñas."
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnVerRecetas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VER RECETAS"/>

    <Button
        android:id="@+id/btnAgregarReceta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AGREGAR RECETA"
        android:layout_marginTop="12dp"/>

</LinearLayout>
